# Supabase Dashboard -> Project Settings -> API
# The "anon" key (newer dashboards call it the "publishable" key) is safe to expose to the browser,
# because every table is protected by Row Level Security.
# NEVER put the service_role / secret key in any NEXT_PUBLIC_ variable or in client code.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
